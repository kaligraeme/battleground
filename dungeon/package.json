{
  "name": "lumenfall",
  "version": "0.1.0",
  "private": true,
  "description": "Lumenfall: a four-player co-op dungeon RPG with random dungeons, wave fights, telegraphed boss mechanics and AI party members",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts --port 8787",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --trace off",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
